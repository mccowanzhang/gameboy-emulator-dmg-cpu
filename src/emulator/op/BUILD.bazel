load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "decoder",
    srcs = ["decoder.cpp"],
    hdrs = ["decoder.h"],
    deps = [
        ":op_base",
        ":add",
        ":bit",
        ":inc",
        ":ld",
        ":nop",
        ":stack",
        ":sub",
    ],
    visibility = ["//visibility:public"],
)

# Base abstract class
cc_library(
    name = "op_base",
    srcs = ["op_base.cpp"],
    hdrs = ["op_base.h"],
    deps = [
        "@abseil-cpp//absl/log",
        "//src/emulator:memory",
        "//src/emulator:registers",
    ],
)

# Individual concrete operations

COMMON_OP_DEPS = [
    ":op_base",
    "//src/emulator:memory",
    "//src/emulator:registers",
    "//src/emulator:util",
    "@abseil-cpp//absl/log",
]

cc_library(
    name = "ld",
    srcs = ["ld.cpp"],
    hdrs = ["ld.h"],
    deps = COMMON_OP_DEPS,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "nop",
    srcs = ["nop.cpp"],
    hdrs = ["nop.h"],
    deps = COMMON_OP_DEPS,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "add",
    srcs = ["add.cpp"],
    hdrs = ["add.h"],
    deps = COMMON_OP_DEPS,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "bit",
    srcs = ["bit.cpp"],
    hdrs = ["bit.h"],
    deps = COMMON_OP_DEPS,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "inc",
    srcs = ["inc.cpp"],
    hdrs = ["inc.h"],
    deps = COMMON_OP_DEPS,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "stack",
    srcs = ["stack.cpp"],
    hdrs = ["stack.h"],
    deps = COMMON_OP_DEPS,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "sub",
    srcs = ["sub.cpp"],
    hdrs = ["sub.h"],
    deps = COMMON_OP_DEPS,
    visibility = ["//visibility:public"],
)
